# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API.

# Public (sent to the browser) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe for the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The address of this app. Used in password-reset and invite email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (NEVER prefix with NEXT_PUBLIC_, never commit) -----------------
# The "service_role" / "secret" key. Only used on the server to invite/create
# and deactivate members. Without it, everything else still works.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone alerts (Web Push). Create the keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://your-domain
VAPID_SUBJECT=

# Server only. At least 32 random characters. The database sends it when it
# calls /api/hooks/* (save the same value in Supabase Vault as app_hook_secret).
APP_HOOK_SECRET=

# Server only. Video picker: the JSON key of a view-only Google service account,
# and the id of the shared "Social Media Videos" Drive folder.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
